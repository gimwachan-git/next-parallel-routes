{
  "name": "next-parallel-routes",
  "version": "1.0.2",
  "description": "Drop-in next.config plugin: dedupes generateStaticParams across parallel-route page.tsx siblings to avoid the cartesian-product explosion in next.js 16.x.",
  "keywords": [
    "next",
    "nextjs",
    "next.js",
    "parallel-routes",
    "generateStaticParams",
    "static-export",
    "ssg",
    "catch-all",
    "app-router"
  ],
  "license": "MIT",
  "author": "Gimwa Chan <ou.kinkin227@gmail.com>",
  "homepage": "https://github.com/gimwachan-git/next-parallel-routes#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gimwachan-git/next-parallel-routes.git"
  },
  "bugs": {
    "url": "https://github.com/gimwachan-git/next-parallel-routes/issues"
  },
  "main": "./index.cjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.cjs"
    },
    "./macro": {
      "types": "./macro.d.ts",
      "default": "./macro.cjs"
    },
    "./preload": "./preload.cjs"
  },
  "files": [
    "index.cjs",
    "index.d.ts",
    "macro.cjs",
    "macro.d.ts",
    "preload.cjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "check-type": "tsc --noEmit"
  },
  "peerDependencies": {
    "next": "16.x"
  },
  "dependencies": {
    "chalk": "^4.1.2"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "typescript": "^5.7.3",
    "vitest": "^4.0.17"
  }
}
